# =============================================================================
# AutoEdit — variables d'environnement
#
# Copier ce fichier en `.env` à la racine et remplir les valeurs.
# JAMAIS de secrets réels dans le repo.
# =============================================================================

# -----------------------------------------------------------------------------
# Environnement (development | staging | production)
# - production active le fail-closed du rate-limiter et exige SECRET_KEY défini.
# -----------------------------------------------------------------------------
APP_ENV=development

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://autoedit:autoedit@postgres:5432/autoedit
DATABASE_URL_SYNC=postgresql://autoedit:autoedit@postgres:5432/autoedit
# Compose-only:
POSTGRES_USER=autoedit
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=autoedit

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# JWT — REQUIS en staging/production. Générer:  openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=replace-me-with-output-of-openssl-rand-hex-32-aaaaaaaaaa
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS (origines autorisées séparées par des virgules) + URL publique
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost
PUBLIC_APP_URL=http://localhost
FRONTEND_ORIGIN=https://your-site.netlify.app
# Domaine public du backend en production. Exemple: srv1305401.hstgr.cloud ou api.autoedit.app
BACKEND_DOMAIN=localhost
# Email Let's Encrypt pour Caddy (renouvellement HTTPS automatique)
TLS_EMAIL=

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_FREE=300
MAX_VIDEO_DURATION_PRO=1800
MAX_VIDEOS_PER_MONTH_FREE=2

# -----------------------------------------------------------------------------
# FedaPay (paiement Mobile Money + cartes)
# - FEDAPAY_SECRET_KEY est REQUIS en production sinon le webhook est rejeté.
# -----------------------------------------------------------------------------
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_ENV=sandbox

# -----------------------------------------------------------------------------
# Whisper (transcription locale)
# -----------------------------------------------------------------------------
WHISPER_MODEL=base

# --- Transcription -----------------------------------------------------------
# auto = ElevenLabs Scribe si ELEVENLABS_API_KEY présent (rapide + précis),
# sinon repli Whisper local. Forcer: elevenlabs | whisper.
TRANSCRIPTION_PROVIDER=auto
TRANSCRIPTION_LANGUAGE=fr
ELEVENLABS_API_KEY=
WHISPER_LANGUAGE=
WHISPER_INITIAL_PROMPT=

# -----------------------------------------------------------------------------
# Email transactionnel (signup / reset password / job done)
# Provider: console (dev only) | smtp | sendgrid
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=AutoEdit <noreply@autoedit.app>
# SMTP (utilisé si EMAIL_PROVIDER=smtp)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# SendGrid (utilisé si EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# -----------------------------------------------------------------------------
# Observabilité (Sentry) — optionnel mais recommandé en prod
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Workers Celery
# -----------------------------------------------------------------------------
CELERY_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Frontend (build-time)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost/api
# En production Netlify, mettre exactement: https://VOTRE_BACKEND_DOMAIN/api
# Exemple: https://srv1305401.hstgr.cloud/api

# =============================================================================
# PIPELINE V2 — B-roll IA & renderers (ne sont utilisées que si activées)
# =============================================================================

# Version de pipeline par défaut: "v1" (existant, stable) ou "v2" (IA B-roll).
PIPELINE_VERSION=v1

# Génération d'images IA (B-roll) via OpenRouter
IMAGE_GENERATION_PROVIDER=openrouter
IMAGE_GENERATION_MODEL=google/gemini-2.5-flash-image
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://autoedit.app
OPENROUTER_X_TITLE=AutoEdit

# Style B-roll par défaut
BROLL_STYLE=african_business_premium
BROLL_DEFAULT_ASPECT_RATIO=9:16
BROLL_MAX_CUES_PER_VIDEO=12
BROLL_MIN_SEGMENT_DURATION=2.5
BROLL_MAX_SEGMENT_DURATION=8.0

# Renderer (overlays animés) — ffmpeg | hyperframes | remotion
VIDEO_RENDERER=hyperframes

# Feature flags produit
ENABLE_AI_BROLL=true
# Scènes motion design illustrées (dessins animés qui illustrent le discours).
# Fonctionne même sans OPENROUTER_API_KEY (dessins procéduraux trait-par-trait).
ENABLE_MOTION_DESIGN=true

# --- Mode économie crédits (montage créateur sans images IA obligatoires) -----
# Stratégie visuelle par défaut quand le job n'en fournit pas une:
#   credit_saver  -> jamais d'image IA payante (MVP rapide, non bloquant)
#   auto_fallback -> tente l'IA, retombe en économique si crédits finis/échec
#   ai_broll      -> ancien comportement (images IA quand possible)
AUTOEDIT_DEFAULT_VISUAL_MODE=auto_fallback
# Coupe-circuit global: true => AUCUNE génération d'image payante, quel que
# soit le mode demandé (utile quand les crédits sont à 0, et dans les tests).
AUTOEDIT_DISABLE_PAID_IMAGE_GENERATION=false

# --- Budget API images (économie) -------------------------------------------
# Cap d'images B-roll générées par vidéo + cadence (secondes par image).
MAX_BROLL_IMAGES=8
SECONDS_PER_BROLL=9.0
SHORTS_SECONDS_PER_BROLL=6.0
# Nombre max de scènes motion design illustrées par l'IA (les autres utilisent
# les dessins procéduraux gratuits). 0 = jamais d'illustration IA.
MOTION_AI_ILLUSTRATIONS_MAX=3
# Précision des images: un modèle texte bon marché réécrit chaque extrait parlé
# en scène visuelle littérale avant la génération (fallback heuristique).
PROMPT_REFINER_ENABLED=1
PROMPT_REFINER_MODEL=google/gemini-2.5-flash-lite

# --- Transcription locale (aucune API payante requise) -----------------------
# ElevenLabs Scribe n'est qu'une accélération optionnelle: sans clé, le pipeline
# transcrit localement et gratuitement.
# auto (défaut) -> faster-whisper s'il est installé, sinon openai-whisper.
WHISPER_BACKEND=auto
# int8 (défaut VPS) | int8_float16 | float32
WHISPER_COMPUTE_TYPE=int8

# --- Moteur d'illustration (backend/app/illustration_engine) -----------------
# Remplace l'ancien motion_design: analyse le discours, décide OÙ une image
# aide vraiment, quoi montrer et comment l'animer sur la voix.
# Mettre false pour repasser sur l'ancien moteur, sans redéploiement.
ILLUSTRATION_ENGINE_ENABLED=true

# offline | free | cloud.
#   offline -> AUCUN appel réseau, aucune clé. C'est le défaut, et il suffit.
#   free    -> FreeLLMAPI, inerte tant que FREELLM_BASE_URL ET FREELLM_MODEL
#              ne sont pas définis (voir docs/THIRD_PARTY_LICENSES.md §3).
#   cloud   -> n'importe quel endpoint compatible OpenAI, à configurer.
ILLUSTRATION_AI_MODE=offline

# Direction artistique par défaut: professional | education | business |
# technology | finance | marketing | minimal | whiteboard | dark_premium | clean
ILLUSTRATION_STYLE=professional
# Densité d'illustrations: low | medium | high
ILLUSTRATION_INTENSITY=medium
# Format cible: 16:9 (YouTube, défaut) | 9:16 | 1:1
ILLUSTRATION_ASPECT=16:9
ILLUSTRATION_FPS=30

# Rythme: durée d'une scène, secondes de visage entre deux scènes, plafond.
ILLUSTRATION_MIN_DUR=3.0
ILLUSTRATION_MAX_DUR=7.0
ILLUSTRATION_MIN_GAP=9.0
ILLUSTRATION_MAX_SCENES=40

# Dessin à la main par whiteboard-animator (MIT, paquet OPTIONNEL: 80 Mo de
# modèle CRAFT + OpenCV/scipy/ONNX). Absent ou false -> moteur de révélation
# natif PIL+numpy, même effet, bien moins gourmand. Rien ne casse.
ILLUSTRATION_USE_WHITEBOARD_ANIMATOR=true
ILLUSTRATION_WHITEBOARD_QUALITY=medium

# Performance VPS: 0 = déduit du nombre de cœurs (2 max). Aucun GPU requis.
ILLUSTRATION_RENDER_WORKERS=0
ILLUSTRATION_PREVIEW_SCALE=0.5
ILLUSTRATION_PREVIEW_FPS=15

# Son: priorité VOIX > SFX > MUSIQUE, appliquée par side-chain ffmpeg.
ILLUSTRATION_SFX_ENABLED=true
ILLUSTRATION_MUSIC_DUCK_DB=-9.0

# --- Fournisseurs sémantiques optionnels (laisser vide = mode offline) -------
# FreeLLMAPI: proxy MIT, MAIS sa licence ne dit rien des CGU des fournisseurs
# derrière lui. En le configurant, vous assumez cette conformité.
FREELLM_BASE_URL=
FREELLM_MODEL=
FREELLM_API_KEY=

# Cloud: aucun fournisseur codé en dur. Indiquez l'endpoint, le modèle, et le
# NOM de la variable d'environnement qui porte la clé (jamais la clé ici).
ILLUSTRATION_CLOUD_BASE_URL=
ILLUSTRATION_CLOUD_MODEL=
ILLUSTRATION_CLOUD_API_KEY_ENV=OPENROUTER_API_KEY

# --- Collage Premium B-roll (moteur `collage_assemble`) ----------------------
# Analyse sémantique -> métaphore visuelle -> collage papier éditorial ->
# éléments qui s'assemblent un par un sur un fond vide. 100 % automatique.
# OPT-IN: à false, rien ne change dans les pipelines V1/V2 existants. Le mode
# de montage « collage_premium » l'active pour un job sans toucher à l'env.
ENABLE_COLLAGE_BROLL=false
# Fournisseur d'images du collage. Vide => réutilise IMAGE_GENERATION_PROVIDER.
# Livrés: openrouter | google_ai_studio | maxfusion | noop.
COLLAGE_IMAGE_PROVIDER=
COLLAGE_IMAGE_MODEL=
# Clés des fournisseurs additionnels (laisser vide si non utilisés).
GOOGLE_AI_STUDIO_API_KEY=
MAXFUSION_API_KEY=
# Animation: local (déterministe, gratuit, hors-ligne) ou http (API
# image->vidéo pilotée par COLLAGE_VIDEO_API_URL / _KEY / _RESULT_PATH).
COLLAGE_VIDEO_PROVIDER=local
# Budget & variété: nb max de scènes collage par vidéo et part maximale des
# beats B-roll qui peuvent partir en collage.
COLLAGE_MAX_SCENES=4
COLLAGE_MAX_SHARE=0.5
# Contrôle qualité automatique (texte/watermark/séparation/cohérence) et
# relance ciblée. QUALITY_MAX_ATTEMPTS=1 désactive le retry.
COLLAGE_QUALITY_ENABLED=1
COLLAGE_QUALITY_MIN_SCORE=62
COLLAGE_QUALITY_MAX_ATTEMPTS=2
# Cache disque content-addressed (concepts + images): un même contenu n'est
# jamais payé deux fois. Vidé automatiquement au-delà du TTL.
COLLAGE_CACHE_ENABLED=1
COLLAGE_CACHE_TTL_DAYS=30
# Parallélisme: appels réseau (I/O) et rendu des clips (CPU).
COLLAGE_IO_WORKERS=4
COLLAGE_RENDER_WORKERS=2

# --- Découpe intelligente -----------------------------------------------------
# Supprime faux départs, phrases répétées, marqueurs "je reprends", bégaiements.
ENGINE_REMOVE_RETAKES=1
ENABLE_DYNAMIC_CAPTIONS=true
ENABLE_SFX=true
ENABLE_MUSIC=true

# --- Nettoyage IA du transcript (smart_cleanup) -------------------------------
# Relecture LLM qui retire répétitions/hésitations/faux départs.
# 1 = actif (si OPENROUTER_API_KEY présent). Niveau par défaut prudent.
ENGINE_LLM_CLEANUP=1
# off | light | balanced | aggressive  (part max de parole retirée: 0/10/20/30 %)
ENGINE_LLM_CLEANUP_LEVEL=light
ENGINE_LLM_CLEANUP_MODEL=google/gemini-2.5-flash-lite

# --- Fonctionnalité Clips (vidéo longue -> shorts) ---------------------------
# Modèle de détection des moments viraux (repli heuristique local sans clé).
ENGINE_VIRAL_MOMENTS_MODEL=google/gemini-2.5-flash-lite
# Limites par plan (secondes / nombre de clips par job)
CLIPS_MAX_SOURCE_DURATION_FREE=1800
CLIPS_MAX_SOURCE_DURATION_PRO=5400
CLIPS_MAX_SOURCE_DURATION_BUSINESS=10800
CLIPS_MAX_PER_JOB_FREE=3
CLIPS_MAX_PER_JOB_PRO=10
CLIPS_MAX_PER_JOB_BUSINESS=15

# --- Rétention des fichiers (purge automatique, jours; 0 = jamais) -----------
# Nécessite `celery beat` (voir DEPLOYMENT.md).
RETENTION_OUTPUT_DAYS=14
RETENTION_SOURCE_DAYS=7
RETENTION_FAILED_JOB_DAYS=2

# --- Recadrage vertical intelligent (suivi de visage) -------------------------
# auto = suivi de visage si OpenCV dispo (fallback centre) | center = centre fixe
SMART_CROP_MODE=auto

# --- Résilience workers (broker Redis + acks_late) ----------------------------
# Délai avant qu'une tâche d'un worker MORT soit redélivrée. Doit dépasser la
# durée du plus long rendu (sinon double exécution). Défaut: 3 h.
CELERY_VISIBILITY_TIMEOUT_SECONDS=10800

# --- Langage lumière du montage -----------------------------------------------
# Flash blanc plein écran aux key moments. Désactivé par défaut (le light-leak
# réel est l'unique effet lumière — évite le « brouillard » visuel).
ENGINE_CAMERA_FLASHES=0
